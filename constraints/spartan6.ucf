# =========================================================
# Spartan-6 FPGA Constraints File
# FILE: spartan6.ucf
# =========================================================

# ---------------------------------------------------------
# CLOCK INPUT
# ---------------------------------------------------------

NET "clk" LOC = "P56" | IOSTANDARD = LVCMOS33;


# ---------------------------------------------------------
# SWITCH INPUTS
# Challenge Input Switches
# ---------------------------------------------------------

NET "sw[0]" LOC = "P38" | IOSTANDARD = LVCMOS33;
NET "sw[1]" LOC = "P39" | IOSTANDARD = LVCMOS33;
NET "sw[2]" LOC = "P40" | IOSTANDARD = LVCMOS33;
NET "sw[3]" LOC = "P41" | IOSTANDARD = LVCMOS33;

NET "sw[4]" LOC = "P42" | IOSTANDARD = LVCMOS33;
NET "sw[5]" LOC = "P43" | IOSTANDARD = LVCMOS33;
NET "sw[6]" LOC = "P44" | IOSTANDARD = LVCMOS33;
NET "sw[7]" LOC = "P45" | IOSTANDARD = LVCMOS33;


# ---------------------------------------------------------
# LED OUTPUTS
# ---------------------------------------------------------

NET "boot_led"  LOC = "P134" | IOSTANDARD = LVCMOS33;
NET "block_led" LOC = "P135" | IOSTANDARD = LVCMOS33;


# ---------------------------------------------------------
# HASH OUTPUT LEDs
# ---------------------------------------------------------

NET "led[0]" LOC = "P120" | IOSTANDARD = LVCMOS33;
NET "led[1]" LOC = "P121" | IOSTANDARD = LVCMOS33;
NET "led[2]" LOC = "P122" | IOSTANDARD = LVCMOS33;
NET "led[3]" LOC = "P123" | IOSTANDARD = LVCMOS33;

NET "led[4]" LOC = "P124" | IOSTANDARD = LVCMOS33;
NET "led[5]" LOC = "P125" | IOSTANDARD = LVCMOS33;
NET "led[6]" LOC = "P126" | IOSTANDARD = LVCMOS33;
NET "led[7]" LOC = "P127" | IOSTANDARD = LVCMOS33;


# ---------------------------------------------------------
# RESET BUTTON
# ---------------------------------------------------------

NET "reset" LOC = "P85" | IOSTANDARD = LVCMOS33;


# ---------------------------------------------------------
# UART (Optional Future Extension)
# ---------------------------------------------------------

NET "uart_tx" LOC = "P101" | IOSTANDARD = LVCMOS33;
NET "uart_rx" LOC = "P102" | IOSTANDARD = LVCMOS33;


# =========================================================
# NOTES
# =========================================================
#
# 1. Replace LOC pin numbers according to your FPGA board.
#
# 2. This file connects:
#    - switches
#    - LEDs
#    - clock
#    - reset
#    - UART
#
# 3. Used for Spartan-6 FPGA implementation
#
# 4. Add this file in:
#
#    constraints/spartan6.ucf
#
# 5. In Xilinx ISE:
#
#    Project → Add Source → spartan6.ucf
#
# =========================================================